{
  "schemaVersion": 1,
  "description": "Inventory of payload Json domain models and typed replacement targets. Deterministic order for CI checks.",
  "schemaPath": "apps/backend/prisma/schema.prisma",
  "repositoryGlob": "apps/backend/src/modules/**/*.repository.ts",
  "excludedPayloadModels": [
    {
      "model": "AdminAuditEvent",
      "table": "admin_audit_events",
      "reason": "Audit log stream; excluded from domain payload migration inventory."
    }
  ],
