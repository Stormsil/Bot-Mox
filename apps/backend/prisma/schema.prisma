  projectKey String   @map("project_key")
  releaseId  String   @map("release_id") @db.Uuid
  status     String   @default("rolled_out")
  wave       String?
  notes      String?
  rolledOutAt DateTime @default(now()) @map("rolled_out_at") @db.Timestamptz(6)
  updatedBy  String?  @map("updated_by")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  release ProjectCatalogRelease @relation(fields: [releaseId], references: [id], onDelete: Restrict)

  @@unique([tenantId, projectKey], map: "ux_tenant_project_rollout_scope")
  @@index([tenantId, updatedAt(sort: Desc)], map: "idx_tenant_project_rollout_tenant_updated")
  @@index([projectKey, status, updatedAt(sort: Desc)], map: "idx_tenant_project_rollout_project_status")
  @@map("tenant_project_rollouts")
}

model TenantAccountAccess {
  tenantId        String    @id @map("tenant_id")
  plan            String    @default("free")
  trialStartedAt  DateTime? @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt     DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  trialUsedAt     DateTime? @map("trial_used_at") @db.Timestamptz(6)
  premiumUntil    DateTime? @map("premium_until") @db.Timestamptz(6)
  lifetimePremium Boolean   @default(false) @map("lifetime_premium")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([plan, updatedAt(sort: Desc)], map: "idx_tenant_account_access_plan_updated")
  @@map("tenant_account_access")
}

model AdminAuditEvent {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId    String?  @map("actor_user_id")
  actorTenantId  String?  @map("actor_tenant_id")
  action         String
  targetTenantId String?  @map("target_tenant_id")
  payload        Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)], map: "idx_admin_audit_events_created")
  @@index([action, createdAt(sort: Desc)], map: "idx_admin_audit_events_action_created")
  @@index([targetTenantId, createdAt(sort: Desc)], map: "idx_admin_audit_events_target_created")
  @@map("admin_audit_events")
}

model DomainEventOutbox {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String    @map("tenant_id")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  eventType     String    @map("event_type")
  eventVersion  Int       @default(1) @map("event_version")
  payload       Json      @default("{}")
  status        String    @default("pending")
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5) @map("max_attempts")
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([status, nextAttemptAt, createdAt(sort: Asc)], map: "idx_domain_event_outbox_relay")
  @@index([tenantId, createdAt(sort: Desc)], map: "idx_domain_event_outbox_tenant_created")
  @@map("domain_event_outbox")
}

model ProcessedDomainEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  consumer    String
  status      String   @default("processing")
  processedAt DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([eventId, consumer], map: "ux_processed_domain_events_event_consumer")
  @@index([consumer, processedAt(sort: Desc)], map: "idx_processed_domain_events_consumer_processed")
  @@map("processed_domain_events")
}
