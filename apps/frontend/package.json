{
  "name": "@botmox/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @botmox/api-contract build",
    "dev": "vite",
    "prebuild": "pnpm --filter @botmox/api-contract build",
    "typecheck": "tsc -b --noEmit",
    "build": "tsc -b && vite build",
    "lint:styles": "stylelint \"src/**/*.css\"",
    "lint": "pnpm run lint:styles && pnpm --dir ../.. exec biome check apps/frontend/src && pnpm --dir ../.. run check:ui:boundaries && pnpm --dir ../.. run check:style:token-usage && pnpm --dir ../.. run check:styles:guardrails",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright show-report",
    "guard:thin-client:delete-modal": "playwright test e2e/thin-client-delete-modal-guard.spec.ts --project=chromium",
    "guard:thin-client:f1-verification": "playwright test e2e/thin-client-f1-verification-guard.spec.ts --project=chromium",
    "guard:thin-client:forbidden": "node e2e/guards/forbidden-local-business-logic.mjs",
    "guard:thin-client": "pnpm run guard:thin-client:forbidden && pnpm run guard:thin-client:f1-verification && pnpm run guard:thin-client:delete-modal"
  },
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@botmox/api-contract": "workspace:*",
    "@monaco-editor/react": "^4.7.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-zone": "^2.5.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.212.0",
    "@opentelemetry/instrumentation": "^0.212.0",
    "@opentelemetry/instrumentation-document-load": "^0.56.0",
    "@opentelemetry/instrumentation-fetch": "^0.212.0",
    "@opentelemetry/instrumentation-user-interaction": "^0.55.0",
    "@opentelemetry/resources": "^2.5.1",
    "@opentelemetry/sdk-trace-base": "^2.5.1",
    "@opentelemetry/sdk-trace-web": "^2.5.1",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "@refinedev/antd": "^6.0.3",
    "@refinedev/core": "^5.0.8",
    "@refinedev/react-router": "^2.0.3",
    "@supabase/supabase-js": "^2.95.3",
    "@tanstack/react-query": "^5.90.5",
    "@ts-rest/core": "^3.52.1",
    "@uiw/react-md-editor": "^4.0.11",
    "antd": "^5.29.3",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "monaco-editor": "^0.55.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.9.6",
    "recharts": "^3.7.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zone.js": "^0.16.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.1.1",
    "astral-regex": "^2.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "stylelint": "^16.14.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4"
  }
}
